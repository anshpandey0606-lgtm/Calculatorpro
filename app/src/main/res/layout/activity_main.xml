<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1C1C1C">

    <!-- Top Bar: Menu (☰), Arrow (⬆️), History (H) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="☰"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="#FFA500"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btnScientific"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="⬆️"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="#4CAF50"
            android:layout_marginEnd="10dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="H"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="#FFFFFF"/>
    </LinearLayout>

    <!-- Display -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:text="0"
        android:textSize="60sp"
        android:textColor="#FFFFFF"
        android:gravity="center|bottom"
        android:padding="20dp"
        android:background="#000000"
        android:layout_marginBottom="30dp"/>

    <!-- Number Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="AC" android:textColor="#FFFFFF" android:background="#FF4444" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnBracket" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="()" android:textColor="#FFFFFF" android:background="#FFA500" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="%" android:textColor="#FFFFFF" android:background="#FFA500" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="÷" android:textColor="#FFFFFF" android:background="#FFA500"/>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="7" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="8" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="9" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="×" android:textColor="#FFFFFF" android:background="#FFA500"/>
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="4" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="5" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="6" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnSubtract" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="-" android:textColor="#FFFFFF" android:background="#FFA500"/>
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="1" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="2" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="3" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="+" android:textColor="#FFFFFF" android:background="#FFA500"/>
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="0" android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="." android:textColor="#FFFFFF" android:background="#333333" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="⌫" android:textColor="#FFFFFF" android:background="#FFA500" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:text="=" android:textColor="#FFFFFF" android:background="#4CAF50"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>